<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds BetterBlueprintLoader's R1 hook with the asset tools NeoRuneExtended ships, and repacks the mod with it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BetterBlueprintLoader passes the tools folder of the SDK it builds with. -->
    <NeoRuneTools Condition="'$(NeoRuneTools)' == ''">$(NuGetPackageRoot)neoruneextended.sdk\1.0.0\tools</NeoRuneTools>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UAssetAPI" HintPath="$(NeoRuneTools)\UAssetAPI.dll" />
    <Reference Include="NeoRuneExtended.Assets" HintPath="$(NeoRuneTools)\NeoRuneExtended.Assets.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(NeoRuneTools)\Newtonsoft.Json.dll" />
    <Reference Include="ZstdSharp" HintPath="$(NeoRuneTools)\ZstdSharp.dll" />
  </ItemGroup>
</Project>
